# Database
DATABASE_URL=postgresql+asyncpg://noorai_user:noorai_pass@localhost:5432/noorai_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-change-this

# AI Services
GROQ_API_KEY=
TAVILY_API_KEY=
CEREBRAS_API_KAY=
CEREBRAS_MODEL=

# Environment: "development" or "production".
# Controls CORS origins - see app/main.py
APP_ENV=development

# Frontend URL allowed by CORS when APP_ENV=production.
# Leave empty in development (localhost origins are used instead).
FRONTEND_URL=


# Sentry error monitoring DSN. Only used when APP_ENV=production.
# Leave empty in development to avoid sending local errors to Sentry.
SENTRY_DSN=